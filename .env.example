# --- Local dev (supabase start) ---
# API URL exposed by the local Supabase stack
SUPABASE_URL=http://host.docker.internal:54321
# Keys printed by `supabase status`
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
# Connexion utilisateur — rôle app_user (authenticated, RLS actif, port direct 5432)
DATABASE_URL=postgresql+asyncpg://app_user:app_user_password@host.docker.internal:54322/postgres
# Connexion service — rôle postgres (BYPASSRLS, migrations, jobs). Défaut = DATABASE_URL si absent.
DATABASE_URL_SERVICE=postgresql+asyncpg://postgres:postgres@host.docker.internal:54322/postgres

# --- Production (Supabase cloud) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# DATABASE_URL=postgresql+asyncpg://app_user:password@db.your-project.supabase.co:5432/postgres
# DATABASE_URL_SERVICE=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

SECRET_KEY=change-me-in-production
DEBUG=true
