# --- Local dev (supabase start) ---
#
# HOST CHOICE — read this before editing:
#   `host.docker.internal` resolves to the host machine from inside Docker
#   (docker-compose sets `extra_hosts: host.docker.internal:host-gateway`).
#   On macOS/Windows with Docker Desktop it also resolves on the host itself,
#   so `make db-seed` and other host-side scripts work with no change.
#
#   Linux host (no Docker Desktop): `host.docker.internal` does NOT resolve
#   outside the container. Use 127.0.0.1 for host-side scripts and keep
#   host.docker.internal for the Docker app, OR run everything inside Docker.
#
# API URL exposed by the local Supabase stack
SUPABASE_API_URL=http://host.docker.internal:54321
# Public URL used for Storage signed URLs (must be reachable from the browser).
# In Docker dev, SUPABASE_API_URL uses host.docker.internal which is not browser-accessible.
SUPABASE_STORAGE_URL=http://127.0.0.1:54321
# Keys printed by `supabase status`
SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
SUPABASE_SECRET_KEY=your-local-secret-key
# User connection — app_user role (authenticated, RLS enabled, direct port 5432)
SUPABASE_DATABASE_USER_URL=postgresql+asyncpg://app_user:app_user_password@host.docker.internal:54322/postgres
# Admin connection — postgres role (BYPASSRLS, migrations, jobs). Defaults to the user URL if absent.
SUPABASE_DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:54322/postgres

# --- Production (Supabase cloud) ---
# SUPABASE_API_URL=https://your-project.supabase.co
# SUPABASE_STORAGE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_SECRET_KEY=your-secret-key
# SUPABASE_DATABASE_USER_URL=postgresql+asyncpg://app_user:password@db.your-project.supabase.co:5432/postgres
# SUPABASE_DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

LOG_DEBUG=true
COOKIES_SECURE=false
RATE_LIMIT_ENABLED=false
# Trust X-Forwarded-For for the client IP (rate limiting, logs). Enable ONLY behind a proxy we
# control that sets it — otherwise callers can spoof their IP. Off by default.
# TRUST_FORWARDED_FOR=true

# --- Optional (all have working defaults — see apps/shared/settings/env.py) ---
# Firehose: structlog events are teed to per-day JSON files here (besides stdout), giving the
# unified logs viewer a recent window to read back. Defaults to the gitignored .firehose/;
# point it at a real log volume in production.
# FIREHOSE_DIR=.firehose
# Postgres schema / Storage bucket for this instance. Isolated per worktree by
# `make worktree` (see scripts/worktree.py); leave unset for the main checkout.
# SUPABASE_DATABASE_SCHEMA=public
# SUPABASE_STORAGE_BUCKET=org-files
# JSON array of allowed CORS origins. Closed by default (no cross-origin access). List the
# exact front-end origins that need cookie-authenticated access; "*" is honoured but serves
# credential-less public reads only (wildcard + credentials is refused).
# CORS_ORIGINS=["https://app.example.com"]
# Cross-instance settings freshness: TTL of the per-process re-read loop; 0 disables.
# SETTINGS_REFRESH_SECONDS=30
# Async substrate: poll interval of the per-process task worker; 0 disables.
# TASK_WORKER_INTERVAL_SECONDS=1.0
# Load metrics: per-process flush of the request accumulator; 0 disables.
# METRICS_FLUSH_SECONDS=60
# Static assets: browser cache TTL (seconds) for un-fingerprinted files; fingerprinted ones
# (?v=…) are served immutable regardless. 0 → always revalidate, handy in dev.
# STATIC_CACHE_SECONDS=3600
# Firehose: per-process drain of the in-memory log queue to the per-day files; 0 disables the
# background writer (the runtime log path then drops lines instead of blocking on I/O).
# FIREHOSE_FLUSH_SECONDS=1.0
# Deployed version (git SHA in Docker); drives error-tracking regression detection.
# APP_VERSION=dev
# SMTP defaults target the local Supabase mail catcher (Mailpit); prod sets
# these to any provider. Sending is best-effort (see apps/shared/email.py).
# SMTP_HOST=127.0.0.1
# SMTP_PORT=54325
# SMTP_SENDER=labase <noreply@labase.local>
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false

# Optional TLS termination by the app itself (docker/entrypoint.sh passes these
# to hypercorn as --certfile/--keyfile). Leave unset if TLS is terminated
# upstream (e.g. a reverse proxy or load balancer).
# SSL_CERTFILE=/path/to/cert.pem
# SSL_KEYFILE=/path/to/key.pem
