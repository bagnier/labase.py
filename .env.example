# --- Local dev (supabase start) ---
# API URL exposed by the local Supabase stack
SUPABASE_URL=http://host.docker.internal:54321
# Keys printed by `supabase status`
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
# Direct Postgres connection (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:54322/postgres

# --- Production (Supabase cloud) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

SECRET_KEY=change-me-in-production
DEBUG=true
