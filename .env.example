# --- Local dev (supabase start) ---
#
# `host.docker.internal` reaches the host from the container (docker-compose's `extra_hosts`).
# Host-side scripts rewrite it to 127.0.0.1 themselves (scripts/envfile.py).
#
SUPABASE_API_URL=http://host.docker.internal:54321
# Storage signed URLs: browser-facing, unlike SUPABASE_API_URL in Docker.
SUPABASE_STORAGE_URL=http://127.0.0.1:54321
# The console's Studio links, browser-facing; empty hides them. A hosted project may leave it
# empty: its dashboard URL is derived.
SUPABASE_STUDIO_URL=http://127.0.0.1:54323/project/default
# Keys printed by `supabase status`
SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
SUPABASE_SECRET_KEY=your-local-secret-key
# app_user (RLS). `make env` sets its password: the migrations leave it unable to log in.
SUPABASE_DATABASE_USER_URL=postgresql+asyncpg://app_user:generated-by-make-env@host.docker.internal:54322/postgres
# postgres (BYPASSRLS); defaults to the user URL.
SUPABASE_DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:54322/postgres

# --- Production (Supabase cloud) ---
# SUPABASE_API_URL=https://your-project.supabase.co
# SUPABASE_STORAGE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_SECRET_KEY=your-secret-key
# SUPABASE_DATABASE_USER_URL=postgresql+asyncpg://app_user:your-app-user-secret@db.your-project.supabase.co:5432/postgres
# SUPABASE_DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

LOG_DEBUG=true
COOKIES_SECURE=false
RATE_LIMIT_ENABLED=false
# Only behind a proxy we control, or callers can spoof their IP.
# TRUST_FORWARDED_FOR=true

# --- Optional: defaults and their reasons in apps/shared/settings/env.py ---
# Day files for log batches Postgres refuses; a real volume in production.
# FIREHOSE_DIR=.cache/firehose
# Set per worktree by `make worktree`; unset for the main checkout.
# SUPABASE_DATABASE_SCHEMA=public
# SUPABASE_STORAGE_BUCKET=org-files
# JSON array; none by default. "*" serves reads without credentials only.
# CORS_ORIGINS=["https://app.example.com"]
# RATE_LIMIT_STORE_TIMEOUT_SECONDS=2.0
# Loop intervals; 0 disables the loop.
# SETTINGS_REFRESH_SECONDS=30
# TASK_WORKER_INTERVAL_SECONDS=1.0
# METRICS_FLUSH_SECONDS=60
# For un-fingerprinted static files; 0 always revalidates.
# STATIC_CACHE_SECONDS=3600
# FIREHOSE_FLUSH_SECONDS=1.0
# The git SHA; an issue seen on a newer version regresses.
# APP_VERSION=dev
# Defaults target Mailpit; production sets any provider.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=54325
# SMTP_SENDER=labase <noreply@labase.local>
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
# BACKUP_STORAGE_PAGE_SIZE=1000

# TLS terminated by the app itself (docker/entrypoint.sh); unset behind a proxy that does it.
# SSL_CERTFILE=/path/to/cert.pem
# SSL_KEYFILE=/path/to/key.pem
