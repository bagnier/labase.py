# --- Local dev (supabase start) ---
#
# HOST CHOICE — read this before editing:
#   `host.docker.internal` resolves to the host machine from inside Docker
#   (docker-compose sets `extra_hosts: host.docker.internal:host-gateway`).
#   On macOS/Windows with Docker Desktop it also resolves on the host itself,
#   so `make db-seed` and other host-side scripts work with no change.
#
#   Linux host (no Docker Desktop): `host.docker.internal` does NOT resolve
#   outside the container. Use 127.0.0.1 for host-side scripts and keep
#   host.docker.internal for the Docker app, OR run everything inside Docker.
#
# API URL exposed by the local Supabase stack
SUPABASE_URL=http://host.docker.internal:54321
# Public URL used for Storage signed URLs (must be reachable from the browser).
# In Docker dev, SUPABASE_URL uses host.docker.internal which is not browser-accessible.
SUPABASE_STORAGE_URL=http://localhost:54321
# Keys printed by `supabase status`
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
# User connection — app_user role (authenticated, RLS enabled, direct port 5432)
DATABASE_URL=postgresql+asyncpg://app_user:app_user_password@host.docker.internal:54322/postgres
# Service connection — postgres role (BYPASSRLS, migrations, jobs). Defaults to DATABASE_URL if absent.
DATABASE_URL_SERVICE=postgresql+asyncpg://postgres:postgres@host.docker.internal:54322/postgres

# --- Production (Supabase cloud) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# DATABASE_URL=postgresql+asyncpg://app_user:password@db.your-project.supabase.co:5432/postgres
# DATABASE_URL_SERVICE=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

LOG_DEBUG=true
COOKIES_SECURE=false
RATE_LIMIT_ENABLED=false
