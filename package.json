{
  "name": "labase",
  "private": true,
  "scripts": {
    "build": "npm run build:htmx && npm run build:fonts && npm run build:css",
    "build:htmx": "cp node_modules/htmx.org/dist/htmx.min.js static/htmx.min.js",
    "build:fonts": "cp node_modules/@fontsource/inter/files/inter-latin-{400,500,600,700}-normal.woff2 static/fonts/",
    "build:css": "tailwindcss -i static/input.css -o static/tailwind.css --minify"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "htmx.org": "2.0.4",
    "tailwindcss": "3.4.19"
  }
}
