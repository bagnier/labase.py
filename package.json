{
  "name": "labase",
  "private": true,
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:fonts && npm run build:icons && npm run build:css && npm run build:editor",
    "build:editor": "mkdir -p static/js/src && esbuild static/js/src/codemirror-editor.js --bundle --minify --outfile=static/js/codemirror-editor.js",
    "build:js": "mkdir -p static/js && cp node_modules/htmx.org/dist/htmx.min.js static/js/htmx.min.js && cp node_modules/sortablejs/Sortable.min.js static/js/sortable.min.js && cp node_modules/alpinejs/dist/cdn.min.js static/js/alpine.min.js && cp node_modules/apexcharts/dist/apexcharts.min.js static/js/apexcharts.min.js",
    "build:fonts": "cp node_modules/@fontsource/inter/files/inter-latin-400-normal.woff2 node_modules/@fontsource/inter/files/inter-latin-500-normal.woff2 node_modules/@fontsource/inter/files/inter-latin-600-normal.woff2 node_modules/@fontsource/inter/files/inter-latin-700-normal.woff2 static/fonts/",
    "build:icons": "mkdir -p static/fonts && cp node_modules/@phosphor-icons/web/src/regular/Phosphor.woff2 static/fonts/",
    "build:css": "tailwindcss -i static/css/input.css -o static/css/tailwind.css --minify",
    "lint": "biome check",
    "lint:gherkin": "gplint -c scripts/.gplintrc features/",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.38",
    "esbuild": "^0.28.2",
    "gplint": "^2.6.0",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "alpinejs": "^3.17.3",
    "apexcharts": "^7.3.0",
    "codemirror": "^6.0.2",
    "htmx.org": "^2.0.10",
    "sortablejs": "^1.15"
  }
}
