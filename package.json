{
  "name": "labase",
  "private": true,
  "scripts": {
    "build": "npm run build:js && npm run build:fonts && npm run build:css",
    "build:js": "mkdir -p static/js && cp node_modules/htmx.org/dist/htmx.min.js static/js/htmx.min.js && cp node_modules/sortablejs/Sortable.min.js static/js/sortable.min.js",
    "build:fonts": "cp node_modules/@fontsource/inter/files/inter-latin-400-normal.woff2 node_modules/@fontsource/inter/files/inter-latin-500-normal.woff2 node_modules/@fontsource/inter/files/inter-latin-600-normal.woff2 node_modules/@fontsource/inter/files/inter-latin-700-normal.woff2 static/fonts/",
    "build:css": "tailwindcss -i static/input.css -o static/tailwind.css --minify --config app/shared/tailwind.config.js"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "htmx.org": "2.0.4",
    "sortablejs": "1.15",
    "tailwindcss": "3.4.19"
  }
}
