{
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(uvx:*)",
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "mcp__playwright__browser_take_screenshot"
    ],
    "deny": [
      "Bash(make db-reset*)",
      "Bash(supabase db reset*)",
      "Bash(*seed.py --reset*)",
      "Bash(*provision_schema.py --reset*)",
      "Task(general-purpose)",
      "Task(Explore)",
      "Task(claude)",
      "Task(Plan)",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "in=$(cat); [ \"$(jq -r '.agent_id // \"null\"' <<<\"$in\")\" = null ] || { echo 'a sub-agent may not spawn a sub-agent' >&2; exit 2; }",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "model": "opus",
  "effortLevel": "high",
  "extraKnownMarketplaces": {
    "labase": {
      "source": {
        "source": "directory",
        "path": "${CLAUDE_PROJECT_DIR}/.claude/plugins"
      }
    }
  },
  "enabledPlugins": {
    "pyright-lsp@labase": true
  }
}
