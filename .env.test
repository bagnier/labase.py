# Background loops off: pytest drives them by hand (drain_task_queue, explicit flushes) against a
# rolled-back connection — a live loop would race it. A real server needs them ON (perf_smoke.py
# overrides TASK_WORKER_INTERVAL_SECONDS, the knob that gates both the task worker and event tailer).
SETTINGS_REFRESH_SECONDS=0
TASK_WORKER_INTERVAL_SECONDS=0
METRICS_FLUSH_SECONDS=0
