SUPABASE_API_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz
SUPABASE_DATABASE_USER_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DATABASE_SCHEMA=test
SUPABASE_STORAGE_BUCKET=org-files-test
LOG_DEBUG=true
COOKIES_SECURE=false
RATE_LIMIT_ENABLED=false
# Background loops off: pytest drives them by hand (drain_task_queue, explicit flushes) against a
# rolled-back connection — a live loop would race it. A real server needs them ON (perf_smoke.py
# overrides TASK_WORKER_INTERVAL_SECONDS, the knob that gates both the task worker and event tailer).
SETTINGS_REFRESH_SECONDS=0
TASK_WORKER_INTERVAL_SECONDS=0
METRICS_FLUSH_SECONDS=0

# Firehose under the gitignored .cache/, so the test suite never pollutes the repo.
FIREHOSE_DIR=.cache/firehose
