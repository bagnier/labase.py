# Talisman config.
#
# `threshold: medium` is the global lever: keyword false-positives (the
# `secret_key` / `publishable_key` field names, the `\.?env` filename pattern)
# are all severity *low*, while real leaked credentials register *high* via the
# entropy / known-pattern detectors. So one threshold clears the noise without
# any per-file or per-token bookkeeping.
#
# The lockfiles and env templates below are still file-ignored: their content is
# high-entropy (sha256 hashes) or documented local placeholders that *would*
# otherwise clear the threshold.
version: "1.0"
threshold: medium
custom_severities:
  - detector: PasswordPhrasePattern
    severity: low
fileignoreconfig:
  - filename: uv.lock
    ignore_detectors: [filecontent]
  - filename: package-lock.json
    ignore_detectors: [filecontent]
  - filename: .env.example
    ignore_detectors: [filecontent, filename]
  - filename: .env.test
    ignore_detectors: [filecontent, filename]
