{
  "mcpServers": {
    "safari": {
      "command": "npx",
      "args": ["-y", "safari-mcp@2.15.12"]
    },
    "context7": {
      "_ref": "https://github.com/upstash/context7",
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "_ref": "https://github.com/microsoft/playwright-mcp",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.79",
        "--headless",
        "--isolated",
        "--browser",
        "chromium",
        "--caps",
        "network,testing,pdf",
        "--console-level",
        "error",
        "--viewport-size",
        "1440x900"
      ]
    }
  }
}
