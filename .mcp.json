{
  "mcpServers": {
    "safari": {
      "command": "npx",
      "args": ["-y", "safari-mcp@2.21.8"]
    },
    "context7": {
      "_ref": "https://github.com/upstash/context7",
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "_ref": "https://github.com/microsoft/playwright-mcp",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.81",
        "--headless",
        "--isolated",
        "--browser",
        "chromium",
        "--caps",
        "network,testing,pdf",
        "--console-level",
        "error",
        "--viewport-size",
        "1440x900",
        "--output-dir",
        ".cache/playwright-mcp"
      ]
    },
    "infomaniak": {
      "_ref": "https://github.com/Mogacode-ma/infomaniak-mcp-agent",
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "infomaniak-mcp-agent@0.15.1"],
      "env": {
        "INFOMANIAK_AUTH_MODE": "manual",
        "INFOMANIAK_API_TOKEN": "${INFOMANIAK_API_TOKEN}",
        "INFOMANIAK_SASESSION": "${INFOMANIAK_SASESSION}",
        "INFOMANIAK_XSRF_TOKEN": "${INFOMANIAK_XSRF_TOKEN}"
      }
    }
  }
}
