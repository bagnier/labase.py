{
  "recommendations": [
    // Python
    "ms-python.python",

    // Pylance — the Python language server (completion, navigation, refactoring). Same
    // pyright core Claude Code's `pyright-lsp` plugin runs, reading the same [tool.pyright]
    // block in pyproject.toml. Its type checking is off: `ty` is the type checker.
    "ms-python.vscode-pylance",

    // Ruff — linting + formatting (replaces black, isort, flake8)
    "charliermarsh.ruff",

    // ty — type checking (Astral)
    "astral-sh.ty",

    // Jinja2 templates
    "samuelcolvin.jinjahtml",

    // Tailwind CSS (completion inside HTML class attributes)
    "bradlc.vscode-tailwindcss",

    // HTMX (completion for hx-* attributes)
    "otovo-oss.htmx-tags",

    // Docker
    "ms-azuretools.vscode-containers",

    // Coverage in the gutter (covered / uncovered lines)
    "ryanluker.vscode-coverage-gutters",

    // .env
    "mikestead.dotenv",

    // Gherkin / pytest-bdd
    "alexkrechik.cucumberautocomplete",

    // TOML (pyproject.toml, uv.lock)
    "tamasfe.even-better-toml",

    // SQL — sqlfluff linting (config: scripts/.sqlfluff)
    "dorzey.vscode-sqlfluff",

    // Biome — JS / CSS / JSON linting + formatting
    "biomejs.biome",

    // GitHub Actions — workflow validation + autocomplete
    "github.vscode-github-actions"
  ]
}
